.duel-root { flex-grow: 1; color: rgb(225, 223, 205); font-size: 16px; background-color: rgba(0, 0, 0, 0); }
.quick-start-layer { position: absolute; left: 0; right: 0; top: 0; bottom: 0; align-items: center; justify-content: center; }
.mini-game-name { position: absolute; top: 14px; left: 50%; translate: -50% 0; max-width: 80%; padding: 8px 24px; border-top-width: 1px; border-bottom-width: 1px; border-color: rgb(170, 142, 79); border-radius: 3px; background-color: rgba(9, 15, 16, 0.9); color: rgb(240, 224, 172); font-size: 18px; -unity-font-style: bold; -unity-text-align: middle-center; white-space: nowrap; }
.hover-tip { position: absolute; width: 280px; max-width: 90%; padding: 10px 12px; background-color: rgba(8, 15, 16, 0.98); border-width: 1px; border-color: rgb(174, 145, 83); border-radius: 4px; }
.hover-tip-title { font-size: 16px; -unity-font-style: bold; color: rgb(238, 214, 155); margin-bottom: 5px; white-space: normal; }
.hover-tip-body { font-size: 14px; color: rgb(217, 222, 210); white-space: normal; }
.manual-selection { position: absolute; left: 32%; right: 32%; top: 27%; padding: 22px; background-color: rgba(9, 15, 16, 0.97); border-width: 1px; border-color: rgb(174, 145, 83); border-radius: 5px; }
.manual-selection Button { height: 48px; margin-bottom: 10px; }
.item-row { flex-direction: row; justify-content: center; margin-top: 12px; }
.item-row { flex-wrap: wrap; }
.ink-live-items { position: absolute; right: 24px; bottom: 266px; width: 190px; }
.ink-live-items .item-choice { width: 180px; height: 90px; }
.ink-effect { position: absolute; left: 0; right: 0; top: 0; bottom: 0; -unity-background-scale-mode: stretch-to-fill; }
.item-choice { width: 180px; height: 138px; align-items: center; justify-content: center; margin-left: 6px; margin-right: 6px; padding: 6px; background-color: rgb(27, 40, 35); border-width: 1px; border-color: rgb(133, 129, 89); border-radius: 4px; }
.item-choice:disabled { opacity: 0.35; }
.item-choice.item-used { opacity: 1; background-color: rgb(59, 51, 26); border-color: rgb(246, 206, 77); border-width: 2px; }
.item-choice.item-spent:disabled { opacity: 1; background-color: rgb(34, 28, 27); border-color: rgb(154, 67, 56); }
.item-choice.item-cooldown:disabled { opacity: 1; background-color: rgb(30, 33, 30); }
.item-spent .item-icon, .item-cooldown .item-icon { opacity: 0.35; }
.item-status { margin-top: 4px; font-size: 13px; color: rgb(246, 206, 77); -unity-text-align: middle-center; }
.item-spent .item-status { color: rgb(235, 125, 108); }
.item-used-mark { position: absolute; top: 6px; left: 0; right: 0; height: 76px; font-size: 64px; -unity-font-style: bold; -unity-text-align: middle-center; color: rgb(225, 66, 53); }
.item-icon { width: 72px; height: 72px; }
.item-name { font-size: 16px; color: rgb(234, 226, 198); }
.item-effect { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.kill-part-icon { width: 30px; height: 32px; margin-right: 10px; flex-shrink: 0; }
.death-rows { flex-shrink: 1; min-height: 0; max-height: 540px; }
.quick-start-title { font-size: 24px; color: rgb(228, 205, 148); -unity-font-style: bold; -unity-text-align: middle-center; }
.quick-start-number { margin-top: 12px; min-width: 130px; padding: 12px 24px; font-size: 72px; -unity-font-style: bold; -unity-text-align: middle-center; color: rgb(240, 224, 172); background-color: rgba(9, 15, 16, 0.88); border-radius: 5px; }
.room-settings { position: absolute; right: 22px; top: 80px; width: 250px; max-width: 32%; padding: 18px; background-color: rgba(9, 15, 16, 0.94); border-width: 1px; border-color: rgb(141, 117, 61); border-radius: 4px; }
.room-settings-title { font-size: 20px; -unity-font-style: bold; margin-bottom: 16px; }
.room-settings Toggle { margin-bottom: 14px; }
.room-settings IntegerField { margin-bottom: 10px; }
.room-settings .unity-base-field__label { min-width: 110px; }
.room-settings .unity-base-text-field__input { background-color: rgb(13, 20, 18); color: rgb(235, 236, 223); padding: 7px; border-width: 1px; border-color: rgb(62, 75, 65); }
.room-settings-note, .room-shot-summary { font-size: 12px; color: rgb(165, 176, 166); white-space: normal; }
.room-shot-summary { -unity-text-align: middle-center; margin-top: 8px; }
.shot-time-remaining { position: absolute; bottom: 96px; left: 35%; right: 35%; padding: 8px; font-size: 18px; -unity-text-align: middle-center; color: rgb(228, 205, 148); background-color: rgba(9, 15, 16, 0.86); }
.clock-panel { position: absolute; left: 22%; right: 22%; bottom: 90px; padding: 16px; background-color: rgba(9, 15, 16, 0.93); border-top-width: 1px; border-top-color: rgb(174, 145, 83); align-items: stretch; }
.clock-title { font-size: 20px; -unity-text-align: middle-center; color: rgb(228, 205, 148); white-space: normal; }
.shooting-notice { margin-top: 8px; padding: 10px 12px; font-size: 18px; white-space: normal; -unity-text-align: middle-center; color: rgb(215, 221, 210); background-color: rgba(24, 33, 31, 0.9); border-radius: 3px; }
.shooting-notice-own { color: rgb(247, 219, 143); -unity-font-style: bold; background-color: rgba(84, 71, 36, 0.65); }
.clock-timer { font-size: 34px; -unity-text-align: middle-center; margin: 8px; white-space: normal; }
.clock-ranking { font-size: 16px; white-space: normal; -unity-text-align: middle-center; }
.clock-ranking-row { padding: 6px 8px; margin-top: 2px; white-space: normal; font-size: 16px; -unity-text-align: middle-center; border-left-width: 3px; border-left-color: rgba(0, 0, 0, 0); }
.clock-ranking-own { color: rgb(247, 219, 143); -unity-font-style: bold; background-color: rgba(84, 71, 36, 0.55); border-left-color: rgb(199, 164, 78); border-radius: 3px; }
.memory-scroll { height: 64px; min-height: 64px; margin-top: 8px; margin-bottom: 8px; flex-shrink: 0; overflow: hidden; }
.memory-arrows { position: relative; height: 64px; flex-shrink: 0; flex-wrap: nowrap; }
.memory-arrow { position: absolute; top: 0; width: 48px; height: 56px; margin: 4px; border-width: 1px; border-color: rgb(91, 106, 98); border-radius: 4px; background-color: rgb(22, 33, 30); color: rgb(236, 225, 190); font-size: 34px; -unity-font-style: bold; -unity-text-align: middle-center; flex-shrink: 0; }
.memory-arrow-hidden { color: rgb(103, 116, 108); }
.memory-arrow-entered { color: rgb(241, 211, 139); border-color: rgb(169, 143, 79); background-color: rgb(50, 47, 29); font-size: 22px; }
.memory-arrow-next { border-color: rgb(237, 212, 151); }
.clock-panel.memory-panel .clock-timer { font-size: 26px; margin: 6px; }
.party-selection-layer { position: absolute; left: 0; right: 0; top: 0; bottom: 0; justify-content: center; align-items: center; }
.party-selector { width: 420px; max-width: 52%; padding: 22px; background-color: rgba(8, 15, 16, 0.96); border-width: 1px; border-color: rgb(141, 117, 61); border-radius: 5px; }
.party-wordmark { font-size: 13px; color: rgb(179, 157, 109); -unity-text-align: middle-center; margin-bottom: 8px; }
.party-selection-title { font-size: 18px; -unity-text-align: middle-center; margin-bottom: 16px; }
.party-reel-window { height: 180px; overflow: hidden; background-color: rgb(15, 24, 24); }
.party-reel { position: absolute; left: 0; right: 0; top: 0; }
.party-reel-label { height: 60px; min-height: 60px; margin: 0; padding: 0; flex-shrink: 0; font-size: 28px; -unity-font-style: bold; -unity-text-align: middle-center; color: rgb(219, 202, 160); }
.party-reel-focus { position: absolute; left: 0; right: 0; top: 60px; height: 60px; border-top-width: 1px; border-bottom-width: 1px; border-color: rgb(215, 179, 92); background-color: rgba(184, 142, 52, 0.09); }
.party-selection-layer.selected .party-selector { border-color: rgb(238, 199, 113); }
.menu-scroll { position: absolute; left: 4%; top: 6%; bottom: 8%; width: 420px; max-width: 92%; background-color: rgba(10, 16, 17, 0.94); border-left-width: 2px; border-left-color: rgb(160, 130, 75); }
.menu-panel { padding: 26px; flex-shrink: 0; }
.menu-panel > * { flex-shrink: 0; }
.chat-layer { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.chat-panel { position: absolute; left: 14px; bottom: 14px; width: 340px; max-width: 65%; height: 150px; max-height: 48%; padding: 10px; background-color: rgba(8, 15, 15, 0.75); border-left-width: 2px; border-left-color: rgb(137, 115, 68); border-radius: 3px; }
.chat-panel.chat-active { width: 420px; height: 320px; background-color: rgba(8, 15, 15, 0.96); border-left-color: rgb(224, 192, 113); }
.chat-title { font-size: 13px; color: rgb(205, 185, 132); margin-bottom: 4px; flex-shrink: 0; }
.chat-log { flex-grow: 1; flex-shrink: 1; min-height: 0; }
.chat-row { font-size: 13px; color: rgb(211, 220, 210); white-space: normal; margin-bottom: 5px; flex-shrink: 0; }
.chat-own { color: rgb(240, 221, 166); }
.chat-input { height: 36px; min-height: 36px; margin-top: 6px; margin-bottom: 2px; flex-shrink: 0; }
.chat-hint { font-size: 11px; color: rgb(157, 169, 154); white-space: normal; margin-top: 3px; flex-shrink: 0; }
.wordmark { color: rgb(195, 170, 112); font-size: 15px; letter-spacing: 3px; margin-bottom: 20px; }
.title { font-size: 34px; -unity-font-style: bold; white-space: normal; margin-bottom: 16px; }
.description { color: rgb(175, 184, 178); font-size: 14px; white-space: normal; margin-bottom: 20px; }
.eyebrow { color: rgb(174, 162, 131); font-size: 12px; letter-spacing: 2px; margin-top: 10px; margin-bottom: 8px; }
Button { height: 44px; padding-left: 15px; padding-right: 15px; margin: 4px; border-width: 1px; border-radius: 2px; font-size: 15px; -unity-font-style: bold; }
Button.primary { background-color: rgb(130, 51, 38); border-color: rgb(166, 78, 55); color: rgb(247, 227, 205); }
Button.primary:hover { background-color: rgb(175, 67, 43); }
Button.secondary { background-color: rgba(29, 40, 38, 0.95); border-color: rgb(90, 105, 90); color: rgb(215, 221, 202); }
Button.secondary:hover { background-color: rgb(55, 69, 57); }
Button.selected { border-color: rgb(235, 190, 97); background-color: rgb(81, 77, 49); }
Button:disabled { opacity: 0.36; }
.button-row { flex-direction: row; justify-content: center; flex-wrap: wrap; }
.button-row Button { flex-grow: 1; min-width: 135px; }
TextField { margin-bottom: 8px; }
.unity-text-field__label { min-width: 90px; color: rgb(165, 176, 166); }
.unity-text-field__input { background-color: rgb(13, 20, 18); color: rgb(235, 236, 223); padding: 7px; border-width: 1px; border-color: rgb(62, 75, 65); }
.rules { color: rgb(185, 179, 149); white-space: normal; font-size: 13px; margin-top: 18px; }
.fineprint { color: rgb(129, 146, 137); font-size: 11px; white-space: normal; margin-top: 16px; }
.match { flex-grow: 1; padding: 22px; }
.hud-top { flex-direction: row; justify-content: space-between; align-items: flex-start; }
.vitals { background-color: rgba(9, 15, 16, 0.85); padding: 10px 20px; min-width: 150px; }
.health { color: rgb(208, 132, 100); font-size: 26px; letter-spacing: 8px; }
.match-info { align-items: center; background-color: rgba(9, 15, 16, 0.65); padding: 8px 22px; }
.small { color: rgb(160, 173, 160); font-size: 11px; letter-spacing: 1px; }
.scene-space { flex-grow: 1; min-height: 80px; }
.hud-bottom { align-self: center; width: 100%; max-width: 720px; background-color: rgba(9, 15, 16, 0.89); padding: 8px 14px; margin-bottom: 28px; border-top-width: 1px; border-top-color: rgb(93, 86, 60); }
.turn { margin-top: 2px; margin-bottom: 2px; font-size: 20px; -unity-font-style: bold; -unity-text-align: middle-center; white-space: normal; }
.ammo { color: rgb(213, 188, 132); font-size: 16px; -unity-text-align: middle-center; margin: 5px; }
.result { margin-top: 3px; color: rgb(155, 171, 158); font-size: 12px; -unity-text-align: middle-center; white-space: normal; margin-bottom: 7px; }
.history { color: rgb(181, 174, 150); font-size: 12px; -unity-text-align: middle-center; margin-top: 4px; }
.status { position: absolute; bottom: 3%; left: 5%; right: 20%; color: rgb(235, 188, 109); font-size: 15px; white-space: normal; background-color: rgba(8, 12, 13, 0.8); padding: 7px; }
Button.exit { position: absolute; bottom: 12px; right: 20px; min-width: 190px; height: 52px; padding-left: 18px; padding-right: 18px; font-size: 17px; background-color: rgba(11, 18, 16, 0.95); border-color: rgb(111, 124, 99); color: rgb(211, 220, 195); }
Button.fullscreen { position: absolute; bottom: 76px; right: 20px; min-width: 190px; height: 44px; }
Button.fullscreen.menu-fullscreen { bottom: 136px; }
Button.quit-game { position: absolute; bottom: 76px; right: 20px; min-width: 190px; height: 44px; }
.quit-confirm-panel { width: 420px; max-width: 92%; padding: 24px; background-color: rgb(10, 17, 17); border-width: 1px; border-color: rgb(141, 117, 61); border-radius: 5px; }
.quit-confirm-title { font-size: 22px; -unity-text-align: middle-center; margin-bottom: 20px; color: rgb(235, 222, 184); white-space: normal; }
.local-player-info { position: absolute; bottom: 136px; right: 24px; width: 190px; flex-direction: column; }
.local-weapon-panel, .local-health-panel { flex-shrink: 0; background-color: rgba(11, 18, 16, 0.9); border-width: 1px; border-color: rgb(90, 105, 90); border-radius: 2px; }
.local-weapon-panel { height: 56px; align-items: center; justify-content: center; }
.local-health-panel { height: 48px; margin-top: 6px; flex-direction: row; align-items: center; justify-content: space-between; padding: 4px 16px; }
.local-health-title { font-size: 16px; color: rgb(215, 221, 202); }
.local-weapon-icon { width: 96px; height: 42px; flex-shrink: 0; }
.local-health { font-size: 28px; -unity-font-style: bold; color: rgb(240, 224, 172); -unity-text-align: middle-center; }
.practice-cancel { position: absolute; bottom: 20px; left: 50%; translate: -50% 0; min-width: 140px; }
.damage-overlay { position: absolute; top: 0; bottom: 0; left: 0; right: 0; background-color: rgba(0, 0, 0, 0); -unity-background-scale-mode: stretch-to-fill; opacity: 0; }
.aim-warning { position: absolute; top: 0; bottom: 0; left: 0; right: 0; -unity-background-scale-mode: stretch-to-fill; }
.qte-digits { flex-direction: row; justify-content: center; margin-top: 6px; margin-bottom: 6px; }
.qte-digit { width: 48px; height: 44px; margin-left: 5px; margin-right: 5px; font-size: 27px; -unity-font-style: bold; -unity-text-align: middle-center; background-color: rgb(22, 30, 30); border-width: 1px; border-color: rgb(70, 80, 75); border-radius: 4px; }
.qte-digit.current { border-color: rgb(237, 189, 100); color: rgb(255, 223, 154); background-color: rgb(58, 49, 31); }
.qte-digit.done { color: rgb(82, 167, 134); background-color: rgb(18, 40, 32); }
.qte-digit.mistake { border-color: rgb(204, 70, 56); }

.unity-base-popup-field__input { background-color: rgb(20, 30, 28); border-width: 1px; border-color: rgb(83, 99, 84); padding: 8px; }
.unity-base-popup-field__text { color: rgb(230, 230, 211); }
.player-card { min-width: 115px; background-color: rgba(9, 15, 16, 0.85); padding: 8px 12px; }
.roster-text { font-size: 14px; white-space: normal; -unity-text-align: middle-center; }
Button.target-button { height: 26px; font-size: 12px; background-color: rgb(29, 40, 38); color: rgb(224, 206, 155); border-color: rgb(115, 104, 75); }
.qte-digits { position: relative; }
.dice-layer { position: absolute; top: 0; bottom: 0; left: 0; right: 0; align-items: center; justify-content: center; }
.dice-panel { width: 420px; max-width: 92%; padding: 18px 24px; align-items: center; background-color: rgb(7, 14, 14); border-width: 1px; border-color: rgb(183, 151, 77); border-radius: 5px; }
.dice-title { color: rgb(230, 209, 149); font-size: 21px; -unity-font-style: bold; margin-bottom: 6px; }
.dice-image { width: 240px; height: 240px; }
.dice-status { font-size: 16px; color: rgb(238, 230, 207); margin: 7px 0; }
.dice-timer { font-size: 13px; color: rgb(170, 174, 161); margin-bottom: 12px; }
.dice-row { width: 100%; padding: 5px 9px; font-size: 15px; color: rgb(223, 224, 204); }
.dice-own { color: rgb(248, 221, 143); background-color: rgba(151, 119, 53, 0.25); }
.nameplate-layer { position: absolute; top: 0; bottom: 0; left: 0; right: 0; }
.seat-dice { position: absolute; width: 100px; height: 112px; margin-left: -50px; padding: 4px; align-items: center; background-color: rgba(8, 13, 13, 0.88); border-width: 1px; border-color: rgb(112, 105, 78); border-radius: 4px; }
.seat-dice-confirmed { border-color: rgb(222, 188, 104); }
.seat-dice-image { width: 80px; height: 80px; flex-shrink: 0; }
.seat-dice-result { font-size: 14px; color: rgb(240, 219, 161); -unity-text-align: middle-center; }
.nameplate { position: absolute; width: 240px; margin-left: -120px; margin-top: 0; padding: 3px 6px; -unity-text-align: middle-center; font-size: 14px; color: rgb(244, 233, 197); background-color: rgba(8, 13, 13, 0.8); border-radius: 3px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.nameplate.nameplate-shooter { border-width: 2px; border-color: rgb(230, 64, 54); padding: 1px 4px; }
.seat-status { font-size: 12px; color: rgb(177, 196, 174); }
.seat-lives { font-size: 16px; color: rgb(219, 143, 125); background-color: rgba(8, 13, 13, 0.55); letter-spacing: 4px; }
.seat-health { font-size: 16px; -unity-font-style: bold; color: rgb(240, 224, 172); }
.speech-layer { position: absolute; top: 0; bottom: 0; left: 0; right: 0; }
.loadout-button { flex-grow: 1; flex-basis: 0; min-height: 64px; height: 64px; align-items: center; justify-content: center; padding: 3px; }
.loadout-button.selected { border-color: rgb(228, 192, 85); background-color: rgb(63, 57, 32); }
.loadout-icon { width: 42px; height: 32px; flex-shrink: 0; }
.speech-stack { position: absolute; width: 340px; translate: -50% -100%; align-items: center; }
.speech-line { max-width: 100%; flex-shrink: 0; margin: 0 0 5px 0; padding: 8px 12px; border-radius: 6px; background-color: rgba(8, 13, 13, 0.92); color: rgb(242, 235, 211); font-size: 17px; white-space: normal; -unity-text-align: middle-center; }
.kill-feed { position: absolute; top: 22px; right: 22px; max-width: 90%; align-items: flex-end; }
.kill-row { flex-direction: row; align-items: center; margin-bottom: 5px; padding: 5px 10px; background-color: rgba(9, 15, 16, 0.86); border-right-width: 2px; border-right-color: rgb(153, 72, 51); border-radius: 3px; }
.kill-stun { color: rgb(119, 212, 246); font-size: 12px; margin-left: 7px; }
.kill-name { max-width: 185px; font-size: 14px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: rgb(233, 229, 207); }
.kill-weapon { width: 64px; height: 32px; margin-left: 3px; margin-right: 9px; flex-shrink: 0; }
.victory-layer { position: absolute; top: 0; bottom: 0; left: 0; right: 0; align-items: center; justify-content: center; }
.victory-banner { max-width: 90%; padding: 16px 34px; font-size: 30px; -unity-font-style: bold; -unity-text-align: middle-center; white-space: normal; color: rgb(240, 224, 172); background-color: rgba(9, 15, 16, 0.88); border-top-width: 2px; border-top-color: rgb(170, 142, 79); border-bottom-width: 2px; border-bottom-color: rgb(170, 142, 79); border-radius: 3px; }
.victory-banner.death-banner { color: rgb(233, 183, 166); border-top-color: rgb(164, 71, 51); border-bottom-color: rgb(164, 71, 51); }
.highlight-layer { position: absolute; top: 0; bottom: 0; left: 0; right: 0; align-items: center; justify-content: center; }
.highlight-banner { width: 760px; max-width: 90%; padding: 12px 20px; font-size: 18px; -unity-text-align: middle-center; white-space: normal; color: rgb(208, 219, 211); background-color: rgb(15, 23, 24); border-left-width: 3px; border-left-color: rgb(178, 143, 70); border-radius: 3px; }
.round-results-layer { position: absolute; top: 208px; bottom: 76px; left: 3%; right: 3%; align-items: center; justify-content: center; }
.round-results { width: 780px; max-width: 100%; max-height: 100%; padding: 12px 18px; background-color: rgb(9, 15, 16); border-width: 1px; border-color: rgb(121, 104, 64); border-radius: 4px; }
.results-title { font-size: 22px; -unity-font-style: bold; -unity-text-align: middle-center; }
.results-summary { font-size: 12px; color: rgb(166, 178, 169); -unity-text-align: middle-center; margin-bottom: 8px; }
.results-scroll { flex-shrink: 1; min-height: 0; }
.results-row { flex-direction: row; align-items: center; min-height: 28px; border-bottom-width: 1px; border-bottom-color: rgb(40, 49, 43); }
.results-header { color: rgb(175, 161, 121); font-size: 12px; }
.results-cell { width: 14.8%; margin: 0; padding: 3px 2px; -unity-text-align: middle-center; font-size: 14px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.results-cell.results-player { width: 26%; -unity-text-align: middle-left; }
.results-winner { color: rgb(247, 219, 143); background-color: rgba(84, 71, 36, 0.45); }
.results-footer { margin-top: 8px; flex-shrink: 0; }
.results-ready { font-size: 12px; -unity-text-align: middle-center; color: rgb(177, 196, 174); }
.round-results .weapon-choice-button { height: 70px; }
.round-results .weapon-choice-icon { height: 28px; }
.weapon-choice { margin-top: 3px; margin-bottom: 5px; }
.weapon-choice-title { -unity-text-align: middle-center; font-size: 13px; color: rgb(187, 183, 157); }
Button.weapon-choice-button { height: 80px; flex-direction: column; align-items: center; justify-content: center; padding: 6px; }
.weapon-choice-icon { width: 100px; height: 40px; flex-shrink: 0; }
.weapon-choice-name { font-size: 15px; -unity-font-style: bold; }
.player-card { max-width: 180px; }
.roster-text { overflow: hidden; text-overflow: ellipsis; }

.death-details { position: absolute; left: 16px; top: 208px; bottom: 90px; width: 280px; padding: 12px; background-color: rgba(9,15,16,0.93); border-left-width: 2px; border-left-color: rgb(164,71,51); border-radius: 3px; }
.death-details-title { font-size: 20px; -unity-font-style: bold; color: rgb(233,183,166); }
.death-details-summary { font-size: 12px; color: rgb(185,195,178); white-space: normal; margin-top: 4px; margin-bottom: 8px; }
.death-details-scroll { flex-shrink: 1; min-height: 0; }
.death-hit { padding: 8px; margin-bottom: 7px; border-left-width: 2px; border-left-color: rgb(133,121,84); background-color: rgb(17,24,24); }
.death-hit-fatal { border-left-color: rgb(190,83,60); }
.death-hit-attacker { font-size: 13px; color: rgb(239,223,183); white-space: normal; -unity-font-style: bold; }
.death-hit-info { font-size: 12px; white-space: normal; color: rgb(192,204,196); margin-top: 4px; }
.crosshair { position: absolute; left: 50%; top: 50%; width: 15px; height: 15px; translate: -7.5px -7.5px; opacity: 0.25; }
.crosshair-line { position: absolute; background-color: rgb(240, 237, 224); }
.hit-marker { position: absolute; left: 50%; top: 50%; width: 32px; height: 32px; translate: -16px -16px; }
.hit-marker-line { position: absolute; width: 8px; height: 2px; background-color: rgb(244, 233, 203); }

.weapon-info-layer { position: absolute; top: 0; bottom: 0; left: 0; right: 0; align-items: center; justify-content: center; background-color: rgba(0, 0, 0, 0.7); }
.weapon-info-panel { width: 720px; max-width: 92%; max-height: 86%; padding: 18px; background-color: rgb(10, 17, 17); border-width: 1px; border-color: rgb(141, 117, 61); border-radius: 5px; }
.weapon-info-heading { flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 8px; flex-shrink: 0; }
.weapon-info-title { font-size: 25px; color: rgb(240, 224, 172); -unity-font-style: bold; }
.weapon-info-scroll { flex-shrink: 1; min-height: 0; }
.weapon-info-intro { font-size: 13px; white-space: normal; color: rgb(177, 196, 174); margin-bottom: 10px; flex-shrink: 0; }
.weapon-info-card { padding: 14px; margin-bottom: 12px; background-color: rgb(20, 29, 27); border-radius: 3px; flex-shrink: 0; }
.weapon-info-card > * { flex-shrink: 0; }
.weapon-info-card-heading { flex-direction: row; align-items: center; margin-bottom: 4px; }
.weapon-info-icon { width: 110px; height: 48px; margin-right: 12px; flex-shrink: 0; }
.weapon-info-name { font-size: 20px; color: rgb(240, 224, 172); -unity-font-style: bold; white-space: normal; }
.weapon-info-section { margin-top: 10px; margin-bottom: 4px; font-size: 14px; color: rgb(210, 189, 130); -unity-font-style: bold; }
.weapon-info-text { font-size: 14px; color: rgb(214, 221, 207); white-space: normal; }

.mini-instruction { font-size: 14px; color: rgb(188, 198, 181); white-space: normal; -unity-text-align: middle-center; margin-top: 8px; }
.clock-timer.signal-wait { color: rgb(237, 150, 131); background-color: rgba(84, 31, 27, 0.8); padding: 14px; border-radius: 6px; }
.clock-timer.signal-fake { color: rgb(244, 210, 122); background-color: rgba(92, 73, 24, 0.8); padding: 14px; border-radius: 6px; }
.clock-timer.signal-go { color: rgb(175, 244, 194); background-color: rgba(29, 86, 47, 0.9); padding: 14px; border-radius: 6px; }
.clock-timer.signal-failure { color: rgb(237, 150, 131); background-color: rgba(84, 31, 27, 0.8); }
.clock-stop-hint { margin-top: 12px; padding: 10px; font-size: 18px; -unity-text-align: middle-center; color: rgb(235, 218, 170); }
.room-list-panel { width: 680px; max-width: 92%; max-height: 85%; padding: 18px; background-color: rgb(10,17,17); border-width: 1px; border-color: rgb(141,117,61); border-radius: 5px; }
.room-list-scroll { height: 320px; flex-shrink: 1; }
.room-list-row { flex-direction: row; align-items: center; padding: 10px; margin-bottom: 6px; background-color: rgb(20,29,27); }
.room-list-info { flex-grow: 1; flex-shrink: 1; }
.room-list-title { font-size: 18px; color: rgb(230,224,199); white-space: normal; }
.room-password-panel { border-top-width: 1px; border-top-color: rgb(100,88,55); padding-top: 10px; margin-top: 8px; }
.room-join-title { font-size: 17px; color: rgb(224,206,151); }
.life-counter { position: absolute; left: 0; right: 0; top: 50%; translate: 0 -36px; flex-direction: row; align-items: center; justify-content: center; }
.life-counter-title { font-size: 44px; color: rgb(235, 219, 170); -unity-font-style: bold; margin-right: 12px; }
.life-number-window { width: 62px; height: 72px; overflow: hidden; }
.life-number-strip { flex-shrink: 0; }
.life-counter-number { height: 72px; min-height: 72px; flex-shrink: 0; margin: 0; padding: 0; font-size: 60px; color: rgb(235, 219, 170); -unity-font-style: bold; -unity-text-align: middle-center; }
.shooter-announcement-layer { position: absolute; left: 0; right: 0; top: 0; bottom: 0; align-items: center; justify-content: center; }
.shooter-announcement { max-width: 90%; padding: 16px 28px; font-size: 34px; -unity-font-style: bold; -unity-text-align: middle-center; white-space: normal; color: rgb(240, 224, 172); background-color: rgba(9, 15, 16, 0.9); border-top-width: 2px; border-top-color: rgb(170, 142, 79); border-bottom-width: 2px; border-bottom-color: rgb(170, 142, 79); border-radius: 3px; }
